---
to: config/mail.ts
---
import { defineConfig, transports } from '@c9up/rover'
import env from '#start/env'

export default defineConfig({
  // Has to name one of the mailers below, or the application refuses to boot.
  // No fallback on purpose: an unset MAIL_MAILER must stop the boot, not
  // quietly select the log mailer, which delivers nothing.
  default: env.get('MAIL_MAILER', ''),
  from: env.get('MAIL_FROM', 'noreply@example.com'),

  mailers: {
    // Writes to the console instead of sending. The development mailer. Bodies
    // are left out unless `logBody: true` is set.
    log: transports.log(),

    smtp: transports.smtp({
      host: env.get('SMTP_HOST', ''),
      port: env.get('SMTP_PORT', '587'),
      // Uncomment if the server needs authentication. Credentials are only
      // ever sent over TLS: implicit TLS on 465, STARTTLS required on 587.
      // user: env.get('SMTP_USERNAME'),
      // pass: env.get('SMTP_PASSWORD'),
    }),
  },
})